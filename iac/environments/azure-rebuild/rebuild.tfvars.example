# Parámetros públicos para reconstruir el WMS de demostración. El lifecycle.ps1
# genera y pasa el paquete ZIP actual; cambie los sufijos si Azure informa que
# algún nombre global ya está ocupado. No contiene claves ni contraseñas.
resource_group_name  = "rg-tangamandapio-rebuild-wus"
storage_account_name = "sttangama261030r"
key_vault_name       = "kv-tangama-261030r"
function_app_name    = "tangama-wms-261030"
name_prefix          = "tangama"
# lifecycle.ps1 pasa function_package_path con el ZIP generado en cada ejecución.
alert_email_receivers = []
